<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <!-- Left Time Column (Start / End stacked vertically) -->
    <LinearLayout
        android:layout_width="42dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_item_start_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14:00"
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_item_end_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="16:00"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- Vertical Source Accent Bar -->
    <TextView
        android:id="@+id/widget_item_source_bar"
        android:layout_width="3.5dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="10dp"
        android:background="#FF4285F4"
        android:text="" />

    <!-- Right Content Column: Title + Calendar Type (+ Collision if any) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Event Title"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_item_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Google Calendar"
            android:textColor="#FF60A5FA"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <!-- Collision Highlight Box (only visible when overlapping) -->
        <LinearLayout
            android:id="@+id/widget_item_collision_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_collision_bg"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_item_collision_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="⚠ Overlaps with event"
                android:textColor="#FFEF4444"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
