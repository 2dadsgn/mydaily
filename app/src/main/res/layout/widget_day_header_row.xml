<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_day_header_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/widget_day_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="TODAY • SUN, NOV 8"
        android:textColor="@color/widget_accent_blue"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_day_header_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2 events"
        android:textColor="@color/widget_text_secondary"
        android:textSize="10.5sp"
        android:textStyle="bold" />

</LinearLayout>
